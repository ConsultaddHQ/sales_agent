# Copy to .env (or .env.production) before `npm run build`. Baked into widget.js.
# Sentry DSNs are public by design (they only allow sending events) — safe in the bundle.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Optional: release tag, e.g. the git SHA — lets Sentry group errors by build
VITE_RELEASE=

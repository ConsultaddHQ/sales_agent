# Marketing website (Vite). Copy to .env and fill in.

# Backend API (onboarding-service)
VITE_API_URL=http://localhost:8005

# Booking calendar shown on /request
VITE_CALENDLY_URL=https://calendly.com/your-handle/intro

# --- Pop Sales Agent (the AI AE embedded on this site) ---
# ElevenLabs agent id created via: create_sales_agent() (elevenlabs_agent.py)
VITE_SALES_AGENT_ID=
# Built widget IIFE served by onboarding-service. NEVER the Vite dev build
# (Fast Refresh breaks the custom element — project invariant).
VITE_WIDGET_URL=http://localhost:8005/widget/widget.js

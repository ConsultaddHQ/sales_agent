SUPABASE_URL=
SUPABASE_KEY=
STORE_IMAGES_PATH=./images

# ElevenLabs
ELEVENLABS_API_KEY=
# Sonal — Premium Indian English (professional). Chosen 2026-07-07 after an RMS
# loudness A/B: prior voices collapsed on long descriptive text (Anya
# gYf9sqh3BkV9QqFMN9Hs: -36dB intro→description delta; Sonal: -0.3dB, steady).
# Jessica (cgSgspJ2msm6clMCkdW9) was American-accented — wrong for this market.
ELEVENLABS_VOICE_ID=NyZqLdjqUb8SpOUKIlWT
# eleven_flash_v2: required base model for English-primary agents — ElevenLabs
# rejects eleven_flash_v2_5/multilingual_v2 outright ("English Agents must use
# turbo or flash v2", confirmed via a live 400 on PATCH, 2026-07-04). Hindi/Tamil
# support comes from create_agent()'s additional_languages/hinglish_mode params
# (language_presets + language_detection system tool), not this field. Telugu
# has no supported real-time model at all (only the slower Eleven v3).
ELEVENLABS_TTS_MODEL=eleven_flash_v2
# LLM for agent brain. Winner of the 2026-04-17 latency A/B test:
#   claude-haiku-4-5       ← DEFAULT. 100% tool reliability, median
#                            User→Products ~3.4s, no 1002 timeouts.
#   gemini-2.5-flash-lite  Close 2nd; slightly faster when it fires, but
#                          less consistent tool discipline.
#   glm-45-air-fp8         Acceptable backup; slower first-cycle.
#   gemini-2.5-flash       DISQUALIFIED (1002 timeouts, slow 2nd-turn).
#   gpt-4.1-nano           DISQUALIFIED (does not call update_products
#                          reliably on ElevenLabs-hosted tier).
#   qwen3-30b-a3b          DISQUALIFIED (>80% tool-call failures).
# See docs/agents/decisions.md for the full result table.
ELEVENLABS_LLM_MODEL=claude-haiku-4-5

# Search service URL (set to ngrok URL before onboarding)
SEARCH_API_URL=http://localhost:8006

# Vision extraction (enrich_from_images.py — one-off product image enrichment).
# Falls back to search-service/.env's OPENROUTER_API_KEY if unset here.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Client acquisition workflow
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=
ADMIN_PASSWORD=
SLACK_WEBHOOK_URL=
CALENDLY_URL=

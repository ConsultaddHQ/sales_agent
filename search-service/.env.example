SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xai/grok-beta
SEARCH_RATE_LIMIT=30/minute
UVICORN_WORKERS=4
RELOAD=true

# Webhook auth: when set, /search and /product-details require the
# X-TeamPop-Secret header (sent by the agent webhook, relayed by the
# onboarding proxy). Must match WEBHOOK_SECRET in onboarding-service.
# Leave blank in dev to disable enforcement; use a long random string in prod.
WEBHOOK_SECRET=
# CORS allowlist (comma-separated origins). "*" = allow all (dev only).
ALLOWED_ORIGINS=*

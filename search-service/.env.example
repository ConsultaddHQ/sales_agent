SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xai/grok-beta
SEARCH_RATE_LIMIT=30/minute
UVICORN_WORKERS=4
RELOAD=true

# Cross-encoder reranker (Stage 2 of hybrid search)
# Set RERANK_ENABLED=false to fall back to Stage-1 vector+FTS order without reranking
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=30
RERANK_TIMEOUT=3.0

SUPABASE_URL=
SUPABASE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xai/grok-beta
SEARCH_RATE_LIMIT=30/minute
UVICORN_WORKERS=4
RELOAD=true

# Cross-encoder reranker (Stage 2 of hybrid search)
# Set RERANK_ENABLED=false to fall back to Stage-1 vector+FTS order without reranking
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
RERANK_TIMEOUT=3.0
# Relevance cutoff: keep results within this cross-encoder score margin of the top hit
# (trims irrelevant tail on specific queries; broad queries stay full). Raise to ~999 to disable.
RERANK_SCORE_MARGIN=4.0


UVICORN_WORKERS=1
SEARCH_RATE_LIMIT=600/minute
SEARCH_EMBEDDING_CONCURRENCY=2
RELOAD=false

# Latency tracking (2026-07-20) — see create_latency_tracking_table.sql at repo root.
# Search result cache: repeat/similar queries within the TTL skip embedding+RPC+rerank entirely.
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=200
# Bump this string on every deploy that changes search timing (cache toggle, reranker
# change, model swap) — it's stamped on every search_latency row so admin's
# /api/latency-summary can compare "before this change" vs "after this change".
SEARCH_CONFIG_VERSION=v1-baseline

# ── Observability (2026-09-29) — see shared/observability.py ──
# json = one JSON object per line (what Grafana Alloy/Loki parse); text = human-readable
LOG_FORMAT=json
LOG_LEVEL=INFO
# Sentry project DSN (Project → Settings → Client Keys). Empty = Sentry off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
# Optional release tag shown in Sentry (e.g. the deployed git SHA)
RELEASE=
# CPU/RAM/swap sample interval for the `system.stats` log line; 0 disables
SYSTEM_STATS_INTERVAL_SECONDS=60

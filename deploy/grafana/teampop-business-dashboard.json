{
  "title": "TeamPop - Business Intelligence",
  "uid": "teampop-business",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "5m",
  "tags": [
    "teampop",
    "business"
  ],
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "postgres",
        "label": "Supabase",
        "type": "datasource",
        "query": "grafana-postgresql-datasource"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Catalog coverage",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Catalog coverage score",
      "id": 2,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE need_met)/nullif(count(*) FILTER (WHERE need_met IS NOT NULL),0),1) AS coverage_pct FROM v_conversation_signals WHERE $__timeFilter(started_at) AND (shopper_need IS NOT NULL OR product_category IS NOT NULL)"
        }
      ],
      "description": "Share of product-seeking conversations where the agent judged the shopper's need was met.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Coverage score by week",
      "id": 3,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('week', started_at) AS time, round(100.0*count(*) FILTER (WHERE need_met)/nullif(count(*) FILTER (WHERE need_met IS NOT NULL),0),1) AS coverage_pct FROM v_conversation_signals WHERE $__timeFilter(started_at) AND (shopper_need IS NOT NULL OR product_category IS NOT NULL) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Demand",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Top unmet needs",
      "id": 5,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT need, count(*) AS mentions, count(DISTINCT conversation_id) AS conversations, count(*) FILTER (WHERE source='zero_result_search') AS zero_result_searches, max(occurred_at) AS last_seen FROM v_bi_unmet_events WHERE $__timeFilter(occurred_at) GROUP BY need ORDER BY mentions DESC LIMIT 25"
        }
      ],
      "description": "What shoppers asked for that the agent said it could not meet, plus searches that returned nothing.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Requested categories",
      "id": 6,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT product_category, count(*) AS conversations FROM v_conversation_signals WHERE $__timeFilter(started_at) AND product_category IS NOT NULL GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Requested products",
      "id": 7,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT product_name, count(*) FILTER (WHERE action='get_product_details') AS detail_views, count(*) FILTER (WHERE action='add_to_cart') AS cart_adds, count(DISTINCT conversation_id) AS conversations FROM v_bi_product_events WHERE $__timeFilter(occurred_at) GROUP BY product_name ORDER BY 2+3 DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Vocabulary gap",
      "id": 8,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT term, count(*) AS mentions, count(DISTINCT conversation_id) AS conversations, count(*) FILTER (WHERE source='shopper_terms') AS as_shopper_term, count(*) FILTER (WHERE source='search_query') AS as_search_query FROM v_bi_vocab_events WHERE $__timeFilter(occurred_at) GROUP BY term ORDER BY mentions DESC LIMIT 30"
        }
      ],
      "description": "Words shoppers use that appear in no product name or description - candidates for synonyms / catalog copy.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Conversion and drop-off",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Conversion by category",
      "id": 10,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(product_category,'unknown') AS category, count(*) AS conversations, count(*) FILTER (WHERE cart_added) AS cart_added, count(*) FILTER (WHERE checkout) AS checkout, round(100.0*count(*) FILTER (WHERE cart_added)/count(*),1) AS cart_rate_pct, round(100.0*count(*) FILTER (WHERE checkout)/count(*),1) AS checkout_rate_pct FROM v_conversation_signals WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Drop-off turn (no cart add)",
      "id": 11,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT user_turns::text AS user_turns, count(*) AS conversations FROM v_conversation_signals WHERE $__timeFilter(started_at) AND NOT cart_added GROUP BY user_turns ORDER BY user_turns"
        }
      ],
      "description": "How many shopper turns happened before they left without adding to cart.",
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "piechart",
      "title": "Drop-off reasons",
      "id": 12,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(drop_off_reason,'unknown') AS reason, count(*) AS conversations FROM v_conversation_signals WHERE $__timeFilter(started_at) AND NOT cart_added GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "pieType": "pie",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Price sensitivity",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Budget mentioned",
      "id": 14,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE budget_mentioned)/nullif(count(*) FILTER (WHERE budget_mentioned IS NOT NULL),0),1) AS budget_mentioned_pct FROM v_conversation_signals WHERE $__timeFilter(started_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Price objection",
      "id": 15,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT round(100.0*count(*) FILTER (WHERE price_objection)/nullif(count(*) FILTER (WHERE price_objection IS NOT NULL),0),1) AS price_objection_pct FROM v_conversation_signals WHERE $__timeFilter(started_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Stated budget (INR)",
      "id": 16,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN budget_amount_inr<300 THEN '1. <300' WHEN budget_amount_inr<600 THEN '2. 300-599' WHEN budget_amount_inr<1000 THEN '3. 600-999' WHEN budget_amount_inr<2000 THEN '4. 1000-1999' ELSE '5. 2000+' END AS bucket, count(*) AS conversations FROM v_conversation_signals WHERE $__timeFilter(started_at) AND budget_amount_inr IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Purchases",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 49
      },
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Purchase lag (conversation to order)",
      "id": 18,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT lag_bucket, count(*) AS orders FROM v_bi_assisted_orders WHERE $__timeFilter(created_at) GROUP BY 1 ORDER BY CASE lag_bucket WHEN '<1h' THEN 1 WHEN '1-24h' THEN 2 WHEN '1-7d' THEN 3 WHEN '>7d' THEN 4 ELSE 5 END"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Assisted revenue",
      "id": 19,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT coalesce(sum(total_price),0) AS assisted_revenue FROM assisted_orders WHERE $__timeFilter(created_at)"
        }
      ],
      "description": "Total value of Shopify orders tagged with a TeamPop conversation.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Assisted orders",
      "id": 20,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 50
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT count(*) AS assisted_orders FROM assisted_orders WHERE $__timeFilter(created_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
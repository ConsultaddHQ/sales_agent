[Unit]
Description=TeamPop onboarding-service (serves /widget + /images, proxies /search)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sales_agent/onboarding-service
EnvironmentFile=/home/ubuntu/sales_agent/onboarding-service/.env
# Runs for SERVING only on the box (widget/images/search-proxy) — the actual
# scrape+embed onboard is run from a laptop, so Chromium is never launched here.
# Single worker is plenty for this low-traffic static/proxy role.
# --proxy-headers: trust Caddy's X-Forwarded-For for correct client IPs in logs.
ExecStart=/home/ubuntu/sales_agent/onboarding-service/.venv/bin/uvicorn main:app \
    --host 0.0.0.0 --port 8005 \
    --proxy-headers --forwarded-allow-ips="*"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
